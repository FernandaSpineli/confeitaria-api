# Copie para .env e ajuste. Gere um segredo com: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-aleatorio-de-pelo-menos-32-bytes
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
DB_USER=confeitaria
DB_PASSWORD=confeitaria
# Primeira ADMIN (criada na subida se ainda não existir)
APP_ADMIN_EMAIL=admin@confeitaria.local
APP_ADMIN_PASSWORD=troque-esta-senha
# Conta de demonstração (demo@exemplo.com / senha12345) com a torta holandesa em 3 tamanhos
APP_DEMO_ENABLED=true
